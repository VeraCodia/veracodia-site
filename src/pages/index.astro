---
import SiteLayout from '../layouts/SiteLayout.astro';
---
<SiteLayout title="VeraCodia - Innovative Software Solutions" >

    <div class="hex-pattern" aria-hidden="true"></div>

    <!-- Hero Section -->
    <section class="hero" id="home">
        <div class="hero-content">
            <div class="hero-text">
                <h1>Innovative Solution for Sustainable Digital Growth</h1>
                <p>
                    VeraCodia bridges the gap between global innovation and
                    local expertise by connecting organizations with top
                    Syrian tech talent to deliver secure, scalable, and
                    future-ready digital solutions.
                </p>
                <div class="hero-buttons">
                    <a href="#contact" class="btn btn-primary"
                    >Get Started</a
                    >
                    <a href="#services" class="btn btn-secondary"
                    >Learn More</a
                    >
                </div>
            </div>
            <div class="hero-visual">
                <div class="hexagon-group" aria-hidden="true">
                    <div class="hexagon hex-1"></div>
                    <div class="hexagon hex-2"></div>
                    <div class="hexagon hex-3"></div>
                    <div class="hexagon hex-4"></div>
                </div>
            </div>
        </div>
    </section>

    <!-- Services Section -->
    <section class="services" id="services">
        <div class="container">
            <div class="section-title">
                <h2>Our Services</h2>
                <p>
                    Comprehensive solutions to drive your digital
                    transformation
                </p>
            </div>
            <div class="services-grid">
                <div class="service-card">
                    <div class="service-icon">
                        <svg
                                class="icon icon-large"
                                viewBox="0 0 24 24"
                                stroke="#ffffff"
                        >
                            <path d="M12 2L2 7l10 5 10-5-10-5z"></path>
                            <path d="M2 17l10 5 10-5"></path>
                            <path d="M2 12l10 5 10-5"></path>
                        </svg>
                    </div>
                    <h3>Digital Transformation</h3>
                    <p>
                        We deliver end-to-end digital transformation through
                        innovative solutions that streamline operations,
                        enhance decision-making, and enable sustainable
                        growth.
                    </p>
                </div>
                <div class="service-card">
                    <div class="service-icon">
                        <svg
                                class="icon icon-large"
                                viewBox="0 0 24 24"
                                stroke="#ffffff"
                        >
                            <rect
                                    x="2"
                                    y="3"
                                    width="20"
                                    height="14"
                                    rx="2"
                                    ry="2"></rect>
                            <line x1="8" y1="21" x2="16" y2="21"></line>
                            <line x1="12" y1="17" x2="12" y2="21"></line>
                        </svg>
                    </div>
                    <h3>Tailored System Solutions</h3>
                    <p>
                        From concept to deployment, we design and build
                        customized software systems that meet each client's
                        unique technical and business requirements.
                    </p>
                </div>
                <div class="service-card">
                    <div class="service-icon">
                        <svg
                                class="icon icon-large"
                                viewBox="0 0 24 24"
                                stroke="#ffffff"
                        >
                            <path
                                    d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"
                            ></path>
                            <polyline points="14 2 14 8 20 8"></polyline>
                            <line x1="16" y1="13" x2="8" y2="13"></line>
                            <line x1="16" y1="17" x2="8" y2="17"></line>
                            <polyline points="10 9 9 9 8 9"></polyline>
                        </svg>
                    </div>
                    <h3>IT Strategy & Consulting</h3>
                    <p>
                        Our experts guide organizations in aligning IT
                        initiatives with business goals, optimizing
                        performance, and ensuring technology investments
                        deliver maximum value.
                    </p>
                </div>
                <div class="service-card">
                    <div class="service-icon">
                        <svg
                                class="icon icon-large"
                                viewBox="0 0 24 24"
                                stroke="#ffffff"
                        >
                            <path
                                    d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"
                            ></path>
                            <polyline points="3.27 6.96 12 12.01 20.73 6.96"
                            ></polyline>
                            <line x1="12" y1="22.08" x2="12" y2="12"></line>
                        </svg>
                    </div>
                    <h3>IT Outsourcing</h3>
                    <p>
                        We provide flexible outsourcing models that give
                        clients access to skilled Syrian professionals,
                        ensuring cost efficiency, scalability, and on-time
                        delivery.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- About Section -->
    <section class="about" id="about">
        <div class="container">
            <div class="about-content">
                <div class="about-text">
                    <h2>About VeraCodia</h2>

                    <p>
                        VeraCodia is a technology solutions provider
                        connecting organizations with top Syrian tech talent
                        to deliver secure, scalable digital solutions. We
                        empower startups, enterprises, and public
                        institutions across telecommunications, finance,
                        logistics, and public services to achieve their
                        strategic goals through visionary digital platforms
                        and enterprise systems.
                    </p>
                    <p>
                        Our multidisciplinary teams combine technical
                        excellence with business insight, helping
                        organizations transform operations, enhance
                        efficiency, and accelerate digital growth.
                    </p>
                    <p>
                        Driven by our belief that technology should catalyze
                        sustainable progress, we deliver innovative,
                        cost-effective solutions through a commitment to
                        quality, transparency, and long-term collaboration.
                    </p>
                    <div style="margin-top: 2rem;">
                        <h3
                                style="font-size: 1.5rem; margin-bottom: 1rem; color: var(--light-cyan);"
                        >
                            Mission
                        </h3>
                        <p>
                            To deliver world-class digital solutions while
                            creating sustainable opportunities for Syrian IT
                            professionals and driving positive digital
                            transformation in the region.
                        </p>
                    </div>
                    <div style="margin-top: 1.5rem;">
                        <h3
                                style="font-size: 1.5rem; margin-bottom: 1rem; color: var(--light-cyan);"
                        >
                            Vision
                        </h3>
                        <p>
                            To be a trusted technology partner that drives
                            innovation and sustainable digital growth,
                            empowering organizations to achieve their full
                            potential.
                        </p>
                    </div>
                </div>
                <div class="hero-visual">
                    <div class="hexagon-group" aria-hidden="true">
                        <div class="hexagon hex-1"></div>
                        <div class="hexagon hex-2"></div>
                        <div class="hexagon hex-3"></div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Awards Section -->
    <section class="services" id="awards" style="padding: 60px 5%;">
        <div class="container">
            <div class="section-title">
                <h2>Awards & Recognition</h2>
                <p>
                    Proud to be recognized for our commitment to excellence
                    and innovation
                </p>
            </div>
            <div
                    style="display: flex; justify-content: center; align-items: center;"
            >
                <div
                        class="service-card"
                        style="max-width: 500px; text-align: center;"
                >
                    <div
                            class="service-icon"
                            style="margin: 0 auto 1.5rem;"
                    >
                        <svg
                                class="icon icon-large"
                                viewBox="0 0 24 24"
                                stroke="#ffffff"
                        >
                            <circle cx="12" cy="8" r="7"></circle>
                            <polyline
                                    points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"
                            ></polyline>
                        </svg>
                    </div>
                    <h3>Sync II - Global Solidarity Award</h3>
                    <p>
                        Recognized for our contribution to global innovation
                        and commitment to creating opportunities through
                        technology.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- Contact Section -->
    <section class="contact" id="contact">
        <div class="container">
            <div class="section-title">
                <h2>Get In Touch</h2>
                <p>Let's discuss how we can help transform your business</p>
            </div>
            <div class="contact-content">
                <div class="contact-info">
                    <div class="contact-item">
                        <div class="contact-icon">
                            <svg
                                    class="icon"
                                    viewBox="0 0 24 24"
                                    stroke="#ffffff"
                            >
                                <path
                                        d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"
                                ></path>
                                <polyline points="22,6 12,13 2,6"
                                ></polyline>
                            </svg>
                        </div>
                        <div>
                            <h4>Email</h4>
                            <p>info@veracodia.com</p>
                        </div>
                    </div>
                    <div class="contact-item">
                        <div class="contact-icon">
                            <svg
                                    class="icon"
                                    viewBox="0 0 24 24"
                                    stroke="#ffffff"
                            >
                                <path
                                        d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"
                                ></path>
                                <circle cx="12" cy="10" r="3"></circle>
                            </svg>
                        </div>
                        <div>
                            <h4>Headquarters</h4>
                            <p>Jisr Abyad, Damascus, Syria</p>
                        </div>
                    </div>
                    <div class="contact-item">
                        <div class="contact-icon">
                            <svg
                                    class="icon"
                                    viewBox="0 0 24 24"
                                    stroke="#ffffff"
                            >
                                <path
                                        d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"
                                ></path>
                                <rect x="2" y="9" width="4" height="12"
                                ></rect>
                                <circle cx="4" cy="4" r="2"></circle>
                            </svg>
                        </div>
                        <div>
                            <h4>LinkedIn</h4>
                            <p>
                                <a
                                        href="https://www.linkedin.com/company/veracodia/"
                                        target="_blank"
                                        style="color: var(--light-cyan); text-decoration: none;"
                                >Connect with us</a>
                            </p>
                        </div>
                    </div>
                </div>
                <form class="contact-form" id="contactForm">
                    <div class="form-group">
                        <label for="message">Your Message</label>
                        <textarea
                                id="message"
                                name="message"
                                placeholder="Tell us about your project or inquiry..."
                                required></textarea>
                    </div>
                    <a
                            href="mailto:info@veracodia.com"
                            class="btn btn-primary"
                            id="sendEmail">Send Message</a
                    >
                </form>
            </div>
        </div>
    </section>


    <!-- Scroll Buttons -->
    <div
            class="scroll-btn scroll-to-top"
            id="scrollToTop"
            title="Scroll to Top"
    >
        <svg class="icon" viewBox="0 0 24 24" stroke="currentColor">
            <path d="M18 15l-6-6-6 6"></path>
        </svg>
    </div>
    <div
            class="scroll-btn scroll-to-bottom"
            id="scrollToBottom"
            title="Scroll to Bottom"
    >
        <svg class="icon" viewBox="0 0 24 24" stroke="currentColor">
            <path d="M6 9l6 6 6-6"></path>
        </svg>
    </div>

    <!-- Easter Egg Canvas -->
    <canvas id="matrixCanvas" class="matrix-rain"></canvas>

    <script>

        // Scroll to top functionality
        scrollToTop.addEventListener("click", () => {
            window.scrollTo({
                top: 0, behavior: "smooth",
            });
        });

        // Scroll to bottom functionality
        scrollToBottom.addEventListener("click", () => {
            const footer = document.getElementById("footer");
            footer.scrollIntoView({
                behavior: "smooth", block: "end",
            });
        });

        // Enhanced mailto with message
        document
            .getElementById("sendEmail")
            .addEventListener("click", function (e) {
                e.preventDefault();
                const message = document.getElementById("message").value;
                if (message.trim()) {
                    const subject = "Inquiry from VeraCodia Website";
                    const body = encodeURIComponent(message);
                    window.location.href = `mailto:info@veracodia.com?subject=${subject}&body=${body}`;

                    // Clear the message after sending
                    setTimeout(() => {
                        document.getElementById("message").value = "";
                    }, 1000);
                } else {
                    alert("Please enter a message before sending.");
                }
            });

        // Intersection Observer for animations
        const observerOptions = {
            threshold: 0.1, rootMargin: "0px 0px -100px 0px",
        };

        const observer = new IntersectionObserver((entries) => {
            entries.forEach((entry) => {
                if (entry.isIntersecting) {
                    entry.target.style.animation = entry.target.dataset.animation || "fadeInUp 0.8s ease both";
                }
            });
        }, observerOptions);

        // Observe elements for animation
        document
            .querySelectorAll(".service-card, .stat-box")
            .forEach((el) => {
                observer.observe(el);
            });

        // Easter Egg: Konami Code
        const konamiCode = ["ArrowUp", "ArrowUp", "ArrowDown", "ArrowDown", "ArrowLeft", "ArrowRight", "ArrowLeft", "ArrowRight", "b", "a",];
        let konamiIndex = 0;
        let matrixActive = false;

        document.addEventListener("keydown", (e) => {
            const key = e.key.toLowerCase();
            if (key === konamiCode[konamiIndex] || e.key === konamiCode[konamiIndex]) {
                konamiIndex++;
                if (konamiIndex === konamiCode.length) {
                    activateMatrixEffect();
                    konamiIndex = 0;
                }
            } else {
                konamiIndex = 0;
            }
        });

        function activateMatrixEffect() {
            if (matrixActive) return;
            matrixActive = true;

            const canvas = document.getElementById("matrixCanvas");
            const ctx = canvas.getContext("2d");

            canvas.width = window.innerWidth;
            canvas.height = window.innerHeight;
            canvas.classList.add("active");

            const chars = "01VERACODIA";
            const fontSize = 14;
            const columns = canvas.width / fontSize;
            const drops = Array(Math.floor(columns)).fill(1);

            function draw() {
                ctx.fillStyle = "rgba(10, 24, 41, 0.05)";
                ctx.fillRect(0, 0, canvas.width, canvas.height);

                ctx.fillStyle = "#19A6CA";
                ctx.font = fontSize + "px monospace";

                for (let i = 0; i < drops.length; i++) {
                    const text = chars[Math.floor(Math.random() * chars.length)];
                    ctx.fillText(text, i * fontSize, drops[i] * fontSize);

                    if (drops[i] * fontSize > canvas.height && Math.random() > 0.975) {
                        drops[i] = 0;
                    }
                    drops[i]++;
                }
            }

            const interval = setInterval(draw, 33);

            setTimeout(() => {
                clearInterval(interval);
                canvas.classList.remove("active");
                setTimeout(() => {
                    ctx.clearRect(0, 0, canvas.width, canvas.height);
                    matrixActive = false;
                }, 1000);
            }, 5000);
        }

        window.addEventListener("resize", () => {
            const canvas = document.getElementById("matrixCanvas");
            canvas.width = window.innerWidth;
            canvas.height = window.innerHeight;
        });
    </script>

    <style>
        /* Hero Section */
        .hero {
            padding: 120px 5% 80px;
            min-height: 100vh;
            display: flex;
            align-items: center;
            position: relative;
            z-index: 2;
        }

        .hero-content {
            max-width: 1400px;
            margin: 0 auto;
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 4rem;
            align-items: center;
        }

        .hero-text h1 {
            font-size: clamp(2.5rem, 5vw, 4rem);
            margin-bottom: 1.5rem;
            line-height: 1.2;
            background: linear-gradient(
                    135deg,
                    var(--white),
                    var(--light-cyan)
            );
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            animation: fadeInUp 0.8s ease;
        }

        .hero-text p {
            font-size: 1.2rem;
            color: var(--text-dim);
            margin-bottom: 2rem;
            animation: fadeInUp 0.8s ease 0.2s both;
        }

        .hero-buttons {
            display: flex;
            gap: 1rem;
            flex-wrap: wrap;
            animation: fadeInUp 0.8s ease 0.4s both;
        }

        .hero-visual {
            position: relative;
            animation: float 6s ease-in-out infinite;
        }

        .hexagon-group {
            width: 100%;
            max-width: 500px;
            height: 500px;
            position: relative;
        }

        .hexagon {
            position: absolute;
            background: linear-gradient(
                    135deg,
                    rgba(25, 166, 202, 0.1),
                    rgba(89, 194, 208, 0.3)
            );
            backdrop-filter: blur(10px);
            border: 1px solid rgba(25, 166, 202, 0.3);
            clip-path: polygon(
                    50% 0%,
                    95% 25%,
                    95% 75%,
                    50% 100%,
                    5% 75%,
                    5% 25%
            );
        }

        .hex-1 {
            width: 200px;
            height: 200px;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            animation: rotate 20s linear infinite;
        }

        .hex-2 {
            width: 150px;
            height: 150px;
            top: 20%;
            left: 20%;
            animation: rotate 15s linear infinite reverse;
        }

        .hex-3 {
            width: 100px;
            height: 100px;
            bottom: 20%;
            right: 20%;
            animation: rotate 25s linear infinite;
        }

        .hex-4 {
            width: 125px;
            height: 125px;
            top: 25%;
            left: 70%;
            animation: rotate 30s linear infinite reverse;
        }

        /* Services Section */
        .services {
            padding: 80px 5%;
            background: linear-gradient(
                    180deg,
                    rgba(14, 38, 70, 0.5),
                    rgba(10, 24, 41, 0.8)
            );
            position: relative;
            z-index: 2;
        }

        .services-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 2rem;
        }

        .service-card {
            background: rgba(14, 38, 70, 0.6);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(25, 166, 202, 0.2);
            border-radius: 20px;
            padding: 2.5rem;
            transition: all 0.3s ease;
            position: relative;
            overflow: hidden;
        }

        .service-card::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(
                    135deg,
                    transparent,
                    rgba(89, 194, 208, 0.1)
            );
            opacity: 0;
            transition: opacity 0.3s ease;
        }

        .service-card:hover {
            transform: translateY(-10px);
            border-color: var(--light-cyan);
        }

        .service-card:hover::before {
            opacity: 1;
        }

        .service-icon {
            width: 80px;
            height: 80px;
            margin-bottom: 1.5rem;
            background: linear-gradient(
                    135deg,
                    var(--logo-cyan),
                    rgba(89, 194, 208, 0.3)
            );
            clip-path: polygon(
                    50% 0%,
                    95% 25%,
                    95% 75%,
                    50% 100%,
                    5% 75%,
                    5% 25%
            );
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .service-card h3 {
            margin-bottom: 1rem;
            font-size: 1.5rem;
        }

        .service-card p {
            color: var(--text-dim);
            line-height: 1.6;
        }

        /* About Section */
        .about {
            padding: 80px 5%;
            position: relative;
            z-index: 2;
        }

        .about-content {
            display: grid;
            grid-template-columns: 1.4fr 1fr;
            gap: 4rem;
            align-items: center;
        }

        .about-text {
            animation: fadeInLeft 0.8s ease;
        }

        .about-text h2 {
            font-size: clamp(2rem, 4vw, 3rem);
            margin-bottom: 1.5rem;
            background: linear-gradient(
                    135deg,
                    var(--white),
                    var(--light-cyan)
            );
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .about-text p {
            color: var(--text-dim);
            line-height: 1.8;
            margin-bottom: 1.5rem;
        }

        .stats-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 2rem;
            margin-top: 2rem;
        }

        .stat-box {
            background: rgba(25, 166, 202, 0.1);
            border: 1px solid rgba(89, 194, 208, 0.3);
            padding: 1.5rem;
            border-radius: 15px;
            text-align: center;
            transition: all 0.3s ease;
        }

        .stat-box:hover {
            background: rgba(89, 194, 208, 0.2);
            transform: scale(1.05);
        }

        .stat-number {
            font-size: 2.5rem;
            font-weight: bold;
            background: linear-gradient(
                    135deg,
                    var(--logo-cyan),
                    var(--light-cyan)
            );
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .stat-label {
            color: var(--text-dim);
            margin-top: 0.5rem;
        }

        /* Contact Section */
        .contact {
            padding: 80px 5%;
            background: linear-gradient(
                    180deg,
                    rgba(14, 38, 70, 0.5),
                    rgba(10, 24, 41, 0.8)
            );
            position: relative;
            z-index: 2;
        }

        .contact-content {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 4rem;
            max-width: 1000px;
            margin: 0 auto;
        }

        .contact-info {
            display: flex;
            flex-direction: column;
            gap: 2rem;
        }

        .contact-item {
            display: flex;
            align-items: center;
            gap: 1rem;
        }

        .contact-icon {
            width: 50px;
            height: 50px;
            background: linear-gradient(
                    135deg,
                    var(--logo-cyan),
                    rgba(89, 194, 208, 0.3)
            );
            clip-path: polygon(
                    50% 0%,
                    95% 25%,
                    95% 75%,
                    50% 100%,
                    5% 75%,
                    5% 25%
            );
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .contact-form {
            background: rgba(14, 38, 70, 0.6);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(25, 166, 202, 0.2);
            border-radius: 20px;
            padding: 2rem;
        }

        .form-group {
            margin-bottom: 1.5rem;
        }

        .form-group label {
            display: block;
            margin-bottom: 0.5rem;
            color: var(--text-light);
        }

        .form-group textarea {
            width: 100%;
            padding: 0.8rem;
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(25, 166, 202, 0.3);
            border-radius: 10px;
            color: var(--white);
            transition: all 0.3s ease;
            font-family: inherit;
        }

        .form-group textarea:focus {
            outline: none;
            border-color: var(--logo-cyan);
            background: rgba(255, 255, 255, 0.1);
        }

        .form-group textarea {
            resize: vertical;
            min-height: 200px;
        }

        /* Easter Egg */
        .matrix-rain {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            z-index: 9999;
            opacity: 0;
            transition: opacity 1s ease;
        }

        .matrix-rain.active {
            opacity: 1;
        }

        /* Responsive Design */
        @media (max-width: 768px) {
            .hero-content,
            .about-content,
            .contact-content {
                grid-template-columns: 1fr;
                gap: 2rem;
            }

            .hero {
                padding: 100px 5% 50px;
                min-height: auto;
            }

            .stats-grid {
                grid-template-columns: 1fr;
            }

            .hero-visual {
                display: none;
            }
        }

